# Lakehouse Console frontend -- environment variables.
#
# These are Vite build-time variables (import.meta.env.VITE_*): Vite inlines
# them into the static bundle when `npm run build` runs, so they must be set
# *before* building the container image for a given environment (e.g. as
# Docker build ARGs/ENV or in a `.env`/`.env.local` file picked up by Vite
# during local `npm run dev`/`npm run build`). See src/vite-env.d.ts for the
# type declarations and src/components/Nav.tsx for how each is consumed.
#
# Copy this file to `.env` (or `.env.local`) and adjust the values for your
# environment. Every variable below is optional -- Nav.tsx falls back to a
# localhost port-forward URL when unset.

# Base URL of the Kafka UI deployment, used for the Console's "Kafka" deep
# dive link (Task 14). Point this at the environment's Kafka UI Route.
VITE_KAFKA_UI_URL=http://localhost:8080

# Base URL of the Apicurio Registry UI deployment, used for the Console's
# "Schema Registry" deep dive link (Task 14).
VITE_APICURIO_UI_URL=http://localhost:8081

# Base URL of the Trino UI deployment, used for the Console's "Trino" deep
# dive link (Task 14).
VITE_TRINO_UI_URL=http://localhost:8082
