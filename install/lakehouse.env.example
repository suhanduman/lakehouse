# ============================================================================
# Lakehouse kurulum değişkenleri — ŞABLON
# ============================================================================
# Bu dosya kurulum boyunca kullanılan BÜTÜN değerlerin tek kaynağıdır.
# Belgelerdeki komutlar yer tutucu değil, buradaki $DEĞİŞKEN adlarını kullanır:
# şablonu kopyalayıp doldurduktan sonra komutlar olduğu gibi kopyala-yapıştır
# çalışır. Değerlerin hangi ekipten isteneceği docs/10-planlama.md §5'tedir.
#
# NASIL KULLANILIR
#   cp install/lakehouse.env.example install/lakehouse.env
#   chmod 600 install/lakehouse.env
#   # boş satırları doldurun, sonra her terminal oturumunda:
#   set -a; . install/lakehouse.env; set +a
#
# GÜVENLİK
#   * Bu dosyanın doldurulmuş kopyası (install/lakehouse.env) PAROLA ve ERİŞİM
#     ANAHTARI içerir. Git'e EKLENMEZ: depo .gitignore'ında `lakehouse.env`
#     satırı vardır; yine de `git status` ile kontrol edin.
#   * Dosya izni 600 olmalı (`chmod 600 install/lakehouse.env`).
#   * Kurulum bittikten ve Secret'lar kümede doğrulandıktan sonra dosya
#     SİLİNEBİLİR (`shred -u install/lakehouse.env`); değerler kümede
#     Secret olarak yaşar. Yükseltme/geri dönüş için saklanacaksa kurumun
#     parola kasasına konur, iş istasyonunda bırakılmaz.
#   * Bu şablonun kendisinde (lakehouse.env.example) SIR YOKTUR; sır alanları
#     bilerek boştur.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Git ve ArgoCD
# ---------------------------------------------------------------------------

# Müşterinin kendi Git sunucusundaki depo kopyasının klonlama adresi (SSH ya da
# HTTPS). ArgoCD kurulumu ve bütün gün-2 değişikliklerini BU adresten okur;
# GitHub'daki ürün deposu değil, sizin kopyanız yazılır.
# Nereden alınır: Git sunucusu (GitLab/Bitbucket/Gitea) depo sayfası → "Clone".
# Doğrulama: git ls-remote "$GIT_REPO_URL" | head -1
GIT_REPO_URL=

# YALNIZ GIT_REPO_URL https:// ile başlıyorsa doldurulur; SSH kullanıyorsanız BOŞ bırakın.
# ArgoCD'nin depoyu okumak için kullanacağı erişim jetonu; SALT OKUMA yetkisi yeter.
# Kurulumda `lakehouse-repo` Secret'ının password alanına yazılır (docs/30-kurulum.md §3.2);
# SSH yolunda onun yerine $HOME/.ssh/lakehouse_deploy anahtarı kullanılır.
# Nereden alınır: Git sunucusunda depo ayarları → Access token / Deploy token.
# Doğrulama: git ls-remote "https://argocd:$GIT_HTTPS_TOKEN@sunucu/yol/lakehouse.git" | head -1
GIT_HTTPS_TOKEN=

# ArgoCD'nin (OpenShift GitOps operatörünün) çalıştığı ad alanı. OpenShift'te
# sabittir; yalnızca GitOps operatörü farklı bir ad alanına kurulduysa değiştirin.
# Nereden alınır: oc get deploy -A | grep -E 'openshift-gitops-server|argocd-server'
ARGOCD_NS=openshift-gitops

# Lakehouse bileşenlerinin (Kafka, Polaris, Trino, Keycloak, Superset,
# JupyterHub, Zeppelin, Spark) kurulacağı ad alanı. Bu değer üründe SABİTTİR;
# DEĞİŞTİRMEYİN. Neden: ad alanı adı ürün dosyalarının içine yazılıdır —
# platform/apps/*.yaml (destination.namespace), platform/values/jupyterhub.yaml
# (POLARIS_URI, TRINO_HOST) ve custom/examples/* hep `lakehouse` taşır; Trino ile
# JupyterHub alt chart'ları da .Release.Namespace üzerinden bu ad alanına kurulur.
# Değiştirirseniz kurulum sessizce iki ad alanına bölünür. Başka bir ad gerekiyorsa
# bu, ayrı bir ürün (kod) görevidir: docs/90-referans/values-anahtarlari.md §1.
# Nereden alınır: sabit, `lakehouse`.
LAKEHOUSE_NS=lakehouse

# ---------------------------------------------------------------------------
# 2) Küme
# ---------------------------------------------------------------------------

# OpenShift Route'larının türetildiği uygulama alan adı. Bileşen adresleri
# bileşen adı + "-" + $LAKEHOUSE_NS + "." + $APPS_DOMAIN olarak üretilir.
# Nereden alınır (küme yöneticisi olarak):
#   oc get ingresses.config cluster -o jsonpath='{.spec.domain}'
APPS_DOMAIN=

# Kalıcı disklerin (Kafka, PostgreSQL, Zeppelin, notebook) isteneceği
# StorageClass. Boş bırakılırsa kümenin varsayılan StorageClass'ı kullanılır;
# ReadWriteOnce blok depolama yeterlidir.
# Nereden alınır: oc get sc        # "(default)" işaretli olan varsayılandır
STORAGE_CLASS=

# Küme içi imaj kayıt defteri. Kafka Connect imajı kümede üretilip buraya
# itilir (özel Dockerfile yoktur). OpenShift'te sabittir.
# Nereden alınır: oc get svc -n openshift-image-registry image-registry
INTERNAL_REGISTRY=image-registry.openshift-image-registry.svc:5000

# ---------------------------------------------------------------------------
# 3) S3 — veri (Iceberg ambarı)
# ---------------------------------------------------------------------------

# S3 uyumlu depolamanın (FlashBlade vb.) HTTPS uç noktası. https:// ile
# başlamalıdır; scripts/check-site.sh bunu denetler.
# Nereden alınır: depolama ekibi.
# Doğrulama: curl -sS -o /dev/null -w '%{http_code}\n' "$S3_ENDPOINT"
S3_ENDPOINT=

# Iceberg tablolarının (Bronze/Silver/Gold) yaşadığı bucket.
# Nereden alınır: depolama ekibi (bu kurulum için ayrılmış bucket).
S3_BUCKET_DATA=

# Veritabanı yedeklerinin yazıldığı bucket. VERİ BUCKET'INDAN AYRI OLMALIDIR:
# geri yükleme hedefi ile kaynağı aynı olamaz.
# Nereden alınır: depolama ekibi.
S3_BUCKET_BACKUP=

# S3 bölge adı. S3 uyumlu depolamalarda çoğu zaman anlamsızdır ama istemciler
# zorunlu tutar; depolama ekibi bir değer vermiyorsa us-east-1 bırakın.
S3_REGION=us-east-1

# Veri bucket'ı için erişim anahtarı çifti. Polaris kataloğu, Kafka Connect
# Iceberg sink'i ve Spark bu anahtarlarla yazar/okur.
# Nereden alınır: depolama ekibi (bu kurulum için ayrılmış hesap).
# Doğrulama: AWS_ACCESS_KEY_ID=$S3_ACCESS_KEY AWS_SECRET_ACCESS_KEY=$S3_SECRET_KEY \
#              aws --endpoint-url "$S3_ENDPOINT" s3 ls "s3://$S3_BUCKET_DATA"
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Yedek bucket'ı için AYRI erişim anahtarı çifti. Ayrı olmasının nedeni:
# veri anahtarları sızsa bile yedeklere erişilememesidir.
# Nereden alınır: depolama ekibi.
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# ---------------------------------------------------------------------------
# 4) Active Directory (gün-1 zorunlu)
# ---------------------------------------------------------------------------

# AD sunucusunun LDAPS adresi. TLS zorunludur (ldaps://, 636).
# Nereden alınır: AD ekibi.
# Doğrulama: openssl s_client -connect ad.example.com:636 -brief </dev/null
LDAP_URL=

# Kullanıcı ve grup okumak için kullanılacak servis hesabının tam DN'i. Yalnız
# OKUMA yetkisi yeterlidir; parola sıfırlama yetkisi İSTENMEZ.
# Nereden alınır: AD ekibi (örnek: CN=svc-lakehouse,OU=Service,DC=example,DC=com).
LDAP_BIND_DN=

# Yukarıdaki servis hesabının parolası. Kümede keycloak-clients Secret'ının
# ldap-bind anahtarına yazılır; values dosyalarına ASLA yazılmaz.
# Nereden alınır: AD ekibi (kasadan).
LDAP_BIND_PASSWORD=

# Kullanıcı nesnelerinin arandığı alt ağaç.
# Nereden alınır: AD ekibi (örnek: OU=Users,DC=example,DC=com).
LDAP_USERS_DN=

# Grup nesnelerinin arandığı alt ağaç. lakehouse-admins, lakehouse-analysts ve
# lakehouse-users grupları bu ağacın altında bulunmalıdır.
# Nereden alınır: AD ekibi (örnek: OU=Groups,DC=example,DC=com).
LDAP_GROUPS_DN=

# AD sunucusunun sertifikasını imzalayan KÖK CA'nın PEM dosyası (yereldeki YOL). Bu
# dosyanın içeriği kurulumda Secret'a konur.
# Nereden alınır: AD ekibinden İSTENİR. Sunucudan çekilen zincir bunun yerine GEÇMEZ:
# zincirin ilk sertifikası AD sunucusunun kendisidir, kök CA çoğu zaman zincirde yoktur.
# Teşhis (yalnız imzalayan CA'nın adını görmek için; çıktı LDAP_CA_FILE değildir):
#   openssl s_client -showcerts -connect ad.example.com:636 </dev/null > ad-chain.pem
# Doğrulama: openssl x509 -in "$LDAP_CA_FILE" -noout -subject -issuer -enddate
LDAP_CA_FILE=

# AD kullanıcı adlarının UPN son eki ("@" dâhil). Zeppelin, Keycloak'ı kullanmaz ve AD'ye
# doğrudan Shiro ile bağlanır; girişte kullanıcı adının sonuna bu son eki ekler
# (kullanici + @kurum.example.net). Boş bırakılırsa Zeppelin girişleri başarısız olur.
# Nereden alınır: AD ekibi. Kullanıcıların userPrincipalName niteliğindeki "@" işaretinden
# sonraki kısımdır; çoğu kurumda e-posta alan adıyla aynıdır.
# Doğrulama (KULLANICI yerine gerçek bir hesap adı yazın):
#   ldapsearch -H "$LDAP_URL" -D "$LDAP_BIND_DN" -w "$LDAP_BIND_PASSWORD" \
#     -b "$LDAP_USERS_DN" "(sAMAccountName=KULLANICI)" userPrincipalName
AD_UPN_SUFFIX=

# ---------------------------------------------------------------------------
# 5) İsteğe bağlı
# ---------------------------------------------------------------------------

# Keycloak yönetici parolası. BOŞ BIRAKILABİLİR: kurulum adımı boşsa
# `openssl rand -hex 24` ile üretir ve keycloak-admin Secret'ına yazar.
# Kendi parolanızı vermek isterseniz buraya yazın (en az 24 karakter).
KEYCLOAK_ADMIN_PASSWORD=
