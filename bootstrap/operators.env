# bootstrap/operators.env — single source of pinned operator/ArgoCD chart
# versions for the VANILLA (non-OpenShift) bootstrap path
# (bootstrap/bootstrap.sh). Sourced as a plain bash env file (KEY=VALUE,
# no spaces around `=`) — keep it that way, it is `source`d directly.
#
# OpenShift does NOT use this file: there, the same operators come from the
# pinned OLM Subscriptions under operators/*.yaml (channel/catalog pins live
# in those YAML files, not here — see operators/README.md).
#
# Repos/versions below mirror the proven vanilla install pattern already
# exercised for the F ingest e2e live environment
# (.superpowers/sdd/bootstrap-ingest-env.sh: strimzi 0.51.0
# --set watchAnyNamespace=true ns strimzi; cnpg 0.29.0 ns cnpg-system) plus
# the operators that script didn't need (cert-manager, external-secrets,
# spark-operator, ArgoCD). Versions are best-known-good at the time this
# file was written — POC-VERIFY against each chart's own repo before a real
# install (`helm search repo <name> --versions`).

# --- Strimzi (Kafka) ---
STRIMZI_CHART_REPO_NAME=strimzi
STRIMZI_CHART_REPO_URL=https://strimzi.io/charts/
STRIMZI_CHART=strimzi/strimzi-kafka-operator
STRIMZI_VERSION=0.51.0
STRIMZI_NAMESPACE=strimzi

# --- CloudNativePG (Postgres) ---
CNPG_CHART_REPO_NAME=cnpg
CNPG_CHART_REPO_URL=https://cloudnative-pg.github.io/charts
CNPG_CHART=cnpg/cloudnative-pg
CNPG_VERSION=0.29.0
CNPG_NAMESPACE=cnpg-system

# --- cert-manager ---
CERT_MANAGER_CHART_REPO_NAME=jetstack
CERT_MANAGER_CHART_REPO_URL=https://charts.jetstack.io
CERT_MANAGER_CHART=jetstack/cert-manager
CERT_MANAGER_VERSION=v1.16.2
CERT_MANAGER_NAMESPACE=cert-manager

# --- External Secrets Operator (only installed when --secrets-mode=external) ---
EXTERNAL_SECRETS_CHART_REPO_NAME=external-secrets
EXTERNAL_SECRETS_CHART_REPO_URL=https://charts.external-secrets.io
EXTERNAL_SECRETS_CHART=external-secrets/external-secrets
EXTERNAL_SECRETS_VERSION=0.10.5
EXTERNAL_SECRETS_NAMESPACE=external-secrets

# --- Spark Operator ---
SPARK_OPERATOR_CHART_REPO_NAME=spark-operator
SPARK_OPERATOR_CHART_REPO_URL=https://kubeflow.github.io/spark-operator
SPARK_OPERATOR_CHART=spark-operator/spark-operator
SPARK_OPERATOR_VERSION=2.1.1
SPARK_OPERATOR_NAMESPACE=spark-operator

# --- Keycloak Operator ---
# ASYMMETRY vs every other operator above: the Keycloak Operator ships no
# official Helm chart. It is installed with `kubectl apply -f
# <pinned-manifest-URL>` instead of `helm upgrade --install`.
# LIVE-VERIFIED (kind e2e, 2026-07-22): kubernetes.yml contains ONLY the
# operator (SA/RBAC/Service/Deployment) — the two CRDs live in SEPARATE
# files in keycloak-k8s-resources and MUST be applied first, or the
# keycloaks.k8s.keycloak.org CRD wait times out on every fresh cluster.
KEYCLOAK_OPERATOR_CRD_URLS="https://raw.githubusercontent.com/keycloak/keycloak-k8s-resources/26.0.7/kubernetes/keycloaks.k8s.keycloak.org-v1.yml https://raw.githubusercontent.com/keycloak/keycloak-k8s-resources/26.0.7/kubernetes/keycloakrealmimports.k8s.keycloak.org-v1.yml"
KEYCLOAK_OPERATOR_MANIFEST_URL=https://raw.githubusercontent.com/keycloak/keycloak-k8s-resources/26.0.7/kubernetes/kubernetes.yml
KEYCLOAK_OPERATOR_NAMESPACE=keycloak-system

# --- ArgoCD (Layer 0 stops once this is up; Layer 1 / Task 8 is the
#     app-of-apps this ArgoCD then syncs) ---
ARGOCD_CHART_REPO_NAME=argo
ARGOCD_CHART_REPO_URL=https://argoproj.github.io/argo-helm
ARGOCD_CHART=argo/argo-cd
ARGOCD_VERSION=7.7.11
ARGOCD_NAMESPACE=argocd
